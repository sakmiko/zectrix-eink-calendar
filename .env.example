# ZECTRIX NOTE4 物理设备 ID
ZECTRIX_DEVICE_ID=AA:BB:CC:DD:EE:FF

# 分配页面通道（1、2、4 或 5；第 3 页已被 Codex 额度雷达独占）
ZECTRIX_PAGE_ID=1

# 极趣云 API 地址与密钥文件路径（或直接设置 ZECTRIX_API_KEY）
ZECTRIX_API_BASE=https://cloud.zectrix.com
ZECTRIX_API_KEY_FILE=/var/lib/zectrix-calendar/secrets/zectrix_api_key

# 外部控制与健康探针监听地址（设为空则关闭；支持 /healthz, /refresh, /page?id=N, /preview.png）
CONTROL_LISTEN=127.0.0.1:9596

# 连续推送失败自愈重启阈值
CALENDAR_MAX_FAIL_STREAK=5
